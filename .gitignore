node_modules/

# Build output. Generated by `npm run build`; never committed, so there is only
# one source of truth for what the site contains.
dist/

# QA screenshots from `npm run qa`, and Playwright's own run artefacts.
qa/
test-results/
playwright-report/

# Optional local workspace for hand-prepared PNG sources when manually re-encoding
# assets via `npm run assets`. Not auto-synced; committed assets/ are authoritative.
assets-raw/

# Deploy archive from `npm run package`.
synqdrive-landing-page.tar.gz
*.tar.gz
